CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7621=y
CONFIG_TARGET_ramips_mt7621_DEVICE_vertell_vt-mt7621d=y

# Web UI for bring-up
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl=y

# Diagnostics
CONFIG_PACKAGE_usbutils=y
CONFIG_PACKAGE_picocom=y

# Vendor-independent VT modem backend + LuCI status page
CONFIG_PACKAGE_vtmodem=y

# T99W175 / QMI
CONFIG_PACKAGE_kmod-usb-net-qmi-wwan=y
CONFIG_PACKAGE_kmod-usb-serial-option=y
CONFIG_PACKAGE_uqmi=y

# Fibocom L860-GL-16 / CDC ACM + CDC NCM
CONFIG_PACKAGE_kmod-usb-acm=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ncm=y

# MT7621 USB host
CONFIG_PACKAGE_kmod-usb3=y

CONFIG_PACKAGE_luci-app-5gmodem=y
CONFIG_PACKAGE_sms-tool=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ncm=y
CONFIG_PACKAGE_kmod-usb-net-cdc-mbim=y
CONFIG_PACKAGE_kmod-usb-serial-option=y

# === РУСИФИКАЦИЯ LUCI ===
CONFIG_LUCI_LANG_ru=y

# === ВСПОМОГАТЕЛЬНЫЕ ПАКЕТЫ ДЛЯ PODKOP ===
CONFIG_PACKAGE_bind-dig=y
CONFIG_PACKAGE_coreutils=y
CONFIG_PACKAGE_coreutils-base64=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_jq=y
CONFIG_PACKAGE_sing-box-tiny=y
CONFIG_PACKAGE_kmod-nf-tproxy=y
CONFIG_PACKAGE_kmod-nft-tproxy=y

# === Софт ===
CONFIG_PACKAGE_ttyd=y
CONFIG_PACKAGE_luci-app-filemanager=y
